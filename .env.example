# Local mode: SQLite remains the default; SNS is disabled.
MEDTRACK_DATA_STORE=sqlite
MEDTRACK_DATABASE_PATH=instance/medtrack.sqlite3
MEDTRACK_SECRET_KEY=replace-with-a-generated-random-value
MEDTRACK_COOKIE_SECURE=0

# Optional AWS mode. Leave SNS disabled unless an existing topic is configured.
DYNAMODB_TABLE_NAME=your-existing-table-name
AWS_REGION=your-aws-region
MEDTRACK_SNS_ENABLED=0
SNS_TOPIC_ARN=arn:aws:sns:your-aws-region:your-account-id:your-topic-name
